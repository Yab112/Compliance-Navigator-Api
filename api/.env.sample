NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-neo4j-password
REDIS_PORT=6379
REDIS_HOST=localhost
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
SECRET_KEY=change-me-in-production
# Encrypts bank accounts and ID numbers (required in production). Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate, put the new key first and keep the old one after a comma until nothing uses it.
PAYOUT_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Auth (self-hosted): 15-minute access tokens + 30-day rotating refresh cookie
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Production over HTTPS: AUTH_COOKIE_SECURE=true. Web and API on different sites: AUTH_COOKIE_SAMESITE=none
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
WEB_BASE_URL=http://localhost:3000
# ENVIRONMENT=production refuses to start with the default SECRET_KEY and hides /docs
ENVIRONMENT=development
# Logging: level, and a file rotated at LOG_MAX_BYTES (empty LOG_FILE = stdout only)
LOG_LEVEL=INFO
LOG_FILE=logs/api.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# Server (main.py): production runs this many worker processes, no auto-reload
# WEB_CONCURRENCY=1
# Reverse proxy addresses allowed to set X-Forwarded-For
# FORWARDED_ALLOW_IPS=127.0.0.1
# Optional SMTP for password-reset emails (otherwise links are logged / issued by admins)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.gov.et

# LLM chat — ollama (free local) | anthropic | keyword (offline fallback)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Optional: ANTHROPIC_API_KEY=sk-ant-...
# Optional: HF_TOKEN=

# Voice STT (faster-whisper, Amharic + English)
WHISPER_MODEL_SIZE=small

# S3 — manual document uploads (AWS, MinIO, R2, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=compliance-navigator-uploads
# Optional: MinIO / Cloudflare R2 custom endpoint
# S3_ENDPOINT_URL=http://localhost:9000
# S3_PUBLIC_BASE_URL=https://your-bucket.s3.amazonaws.com

# Optional legacy vector store (use Supabase pgvector instead)
QDRANT_HOST=localhost
QDRANT_PORT=6333
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=compliance-uploads
UPLOAD_DIR=uploads/references
# Postgres system of record. docker compose creates the database with POSTGRES_PASSWORD
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql://navigator:change-me-postgres-password@localhost:5433/compliance_navigator
# Staff (admin app) origin, used in staff invitation and password links
ADMIN_BASE_URL=http://localhost:3001

# Fayda national ID verification for Guday Geday agents (MOSIP eSignet)
# off = no verification, sandbox = built-in TEST screen (OTP 111111), live = real Fayda
FAYDA_MODE=sandbox
# Live mode only — issued by the National ID Program when you register as a relying party
FAYDA_CLIENT_ID=
FAYDA_AUTHORIZE_URL=
FAYDA_TOKEN_URL=
FAYDA_USERINFO_URL=
FAYDA_JWKS_URL=
# RSA private key (PEM text with \n, or a file path) whose public JWK you gave NIDP
FAYDA_PRIVATE_KEY=
FAYDA_REDIRECT_URI=http://localhost:3000/guday/register/fayda-callback
FAYDA_SANDBOX_URL=http://localhost:3000/guday/register/fayda-sandbox
# Live mode only: the issuer expected in Fayda id_tokens
FAYDA_ISSUER=
# Keys the stored ID hash — set once, never change (defaults to SECRET_KEY)
ID_HASH_PEPPER=

# Payments: off | simulated (local test checkout, no money moves) | chapa
PAYMENTS_MODE=simulated
# From the Chapa dashboard; use the CHASECK_TEST- key until you go live
CHAPA_SECRET_KEY=
# The "secret hash" set in Chapa dashboard > Webhooks
CHAPA_WEBHOOK_SECRET=
PLATFORM_COMMISSION_PERCENT=10
# Public URL of this API so Chapa can call the webhook
API_PUBLIC_URL=http://localhost:8080

# VAT and receipts (Proclamation 1341/2024: standard rate 15%)
VAT_RATE_PERCENT=15
PLATFORM_VAT_REGISTERED=true
PLATFORM_LEGAL_NAME=Compliance Navigator
PLATFORM_TIN=
PLATFORM_VAT_NUMBER=
PLATFORM_ADDRESS=Addis Ababa, Ethiopia
