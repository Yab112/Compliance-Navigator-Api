NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=darixsamani
REDIS_PORT=6379
REDIS_HOST=localhost
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase — Postgres (roadmaps, profiles) + pgvector (RAG) + Auth
# Copy this file to .env and fill in real values. Never commit .env.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# LLM chat — ollama (free local) | anthropic | keyword (offline fallback)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Optional: ANTHROPIC_API_KEY=sk-ant-...
# Optional: HF_TOKEN=

# Voice STT (faster-whisper, Amharic + English)
WHISPER_MODEL_SIZE=small
# Optional direct Postgres (Dashboard → Database → connection string)
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@...pooler.supabase.com:6543/postgres
SUPABASE_STORAGE_BUCKET=compliance-uploads

# S3 — manual document uploads (AWS, MinIO, R2, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=compliance-navigator-uploads
# Optional: MinIO / Cloudflare R2 custom endpoint
# S3_ENDPOINT_URL=http://localhost:9000
# S3_PUBLIC_BASE_URL=https://your-bucket.s3.amazonaws.com

# Optional legacy vector store (use Supabase pgvector instead)
QDRANT_HOST=localhost
QDRANT_PORT=6333
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=compliance-uploads
UPLOAD_DIR=uploads/references